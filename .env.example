# ==============================================================================
# Sintetica - Configuração de Provedores de LLM
# ==============================================================================
# Copie este arquivo para .env e preencha com as suas chaves:
#   cp .env.example .env
#
# NUNCA versione o arquivo .env no Git. Ele está protegido pelo .gitignore.
# ==============================================================================

# Chaves de API das LLMs externas (adicione as chaves que deseja utilizar)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Host do Ollama local (se utilizar Ollama fora do localhost padrão)
OLLAMA_HOST="http://localhost:11434"

# Forçar provedor principal (opcional: harness, ollama, external)
# SINTETICA_PROVIDER="harness"

# Forçar backend externo específico (opcional: openai, anthropic, gemini)
# SINTETICA_EXTERNAL_BACKEND="openai"

# Modelos personalizados (opcional)
# SINTETICA_OPENAI_MODEL="gpt-4o-mini"
# SINTETICA_ANTHROPIC_MODEL="claude-haiku-5-5"
# SINTETICA_GEMINI_MODEL="gemini-1.5-flash"
# SINTETICA_OLLAMA_MODEL="llama3.2"
